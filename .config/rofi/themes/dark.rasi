* {
    font: "Iosevka Nerd Font Medium 11";

    /* Backgrounds */
    bg0: #121212;
    bg1: #161616;
    bg2: #1E1E1E;
    bg3: #262626;

    /* Foregrounds */
    fg0: #8AB4F8;
    fg1: #AEC6CF;
    fg2: #C3B1E1;

    /* Aliases */
    accent: @fg0;
    urgent: @fg2;

    background: @bg0;
    background-alt: @bg1;
    secondary: @bg2;
    foreground: @fg0;

    background-color: @background;
    text-color: @foreground;

    margin: 0;
    padding: 0;
    spacing: 0;
}