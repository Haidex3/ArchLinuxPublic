* {
    font: "Iosevka Nerd Font Medium 11";

    /* Backgrounds */
    bg0: #F6F6FB;
    bg1: #F1F1FA;
    bg2: #F6F6FB;
    bg3: #E8E8F2;

    /* Foregrounds */
    fg0: #BD93F9;
    fg1: #FF79C6;
    fg2: #8BE9FD;

    /* Aliases */
    accent: @fg0;
    urgent: @fg2;

    background: @bg0;
    background-alt: @bg1;
    secondary: @bg2;
    foreground: @fg0;

    background-color: @background;
    text-color: @foreground;

    margin: 0;
    padding: 0;
    spacing: 0;
}